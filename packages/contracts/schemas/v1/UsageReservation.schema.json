{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.instant-ppt.example/v1/UsageReservation.schema.json",
  "title": "UsageReservation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "reservationId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "reservedSlides": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "status": {
      "enum": [
        "reserved",
        "settled",
        "released"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "reservationId",
    "organizationId",
    "jobId",
    "idempotencyKey",
    "reservedSlides",
    "status",
    "createdAt"
  ]
}
