{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.instant-ppt.example/v1/SourcePackage.schema.json",
  "title": "SourcePackage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "language": {
      "enum": [
        "zh-CN",
        "en-US",
        "mixed"
      ]
    },
    "markdownArtifactId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "assetArtifactIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "uniqueItems": true
    },
    "conversionProfileArtifactId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "parserVersion": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "sourceId",
    "organizationId",
    "sourceSha256",
    "language",
    "markdownArtifactId",
    "assetArtifactIds",
    "conversionProfileArtifactId",
    "parserVersion",
    "createdAt"
  ]
}
