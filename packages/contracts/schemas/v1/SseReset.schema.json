{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.instant-ppt.example/v1/SseReset.schema.json",
  "title": "SseReset",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "jobId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "reason": {
      "enum": [
        "retention_window_exceeded",
        "sequence_unavailable"
      ]
    },
    "snapshotUrl": {
      "type": "string",
      "pattern": "^/v1/jobs/"
    },
    "latestSeq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "reason",
    "snapshotUrl",
    "latestSeq"
  ]
}
