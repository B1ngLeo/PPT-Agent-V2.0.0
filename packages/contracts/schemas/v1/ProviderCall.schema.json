{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.instant-ppt.example/v1/ProviderCall.schema.json",
  "title": "ProviderCall",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "providerCallId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "requestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "rate_limited",
        "timed_out"
      ]
    },
    "inputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "outputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "providerCallId",
    "organizationId",
    "provider",
    "model",
    "purpose",
    "requestHash",
    "status",
    "inputTokens",
    "outputTokens",
    "startedAt",
    "finishedAt"
  ]
}
