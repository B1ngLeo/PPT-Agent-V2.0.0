{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.instant-ppt.example/v1/ExportManifest.schema.json",
  "title": "ExportManifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "exportId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "presentationRevisionId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "artifact": {
      "$ref": "https://contracts.instant-ppt.example/v1/ArtifactManifest.schema.json"
    },
    "reusedFromArtifactId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "compilerVersion": {
      "type": "string",
      "minLength": 1
    },
    "packageQaReportId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "exportId",
    "presentationRevisionId",
    "artifact",
    "reusedFromArtifactId",
    "compilerVersion",
    "packageQaReportId",
    "createdAt"
  ]
}
