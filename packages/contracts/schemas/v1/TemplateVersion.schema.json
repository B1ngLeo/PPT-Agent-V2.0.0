{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.instant-ppt.example/v1/TemplateVersion.schema.json",
  "title": "TemplateVersion",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "templateId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "templateVersionId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "native"
    },
    "themeSpec": {
      "$ref": "https://contracts.instant-ppt.example/v1/ThemeSpec.schema.json"
    },
    "pageRoles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "editableElements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "engineCompatibility": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "templateId",
    "templateVersionId",
    "name",
    "category",
    "mode",
    "themeSpec",
    "pageRoles",
    "editableElements",
    "engineCompatibility",
    "createdAt"
  ]
}
