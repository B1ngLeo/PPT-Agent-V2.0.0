{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.instant-ppt.example/v1/AuditEvent.schema.json",
  "title": "AuditEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "auditEventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "actorId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "resourceType": {
      "type": "string",
      "minLength": 1
    },
    "resourceId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "allowed",
        "denied",
        "failed"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "auditEventId",
    "organizationId",
    "actorId",
    "resourceType",
    "resourceId",
    "action",
    "requestId",
    "outcome",
    "occurredAt"
  ]
}
