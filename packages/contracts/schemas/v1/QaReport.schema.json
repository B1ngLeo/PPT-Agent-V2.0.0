{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.instant-ppt.example/v1/QaReport.schema.json",
  "title": "QaReport",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "reportId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "subjectType": {
      "enum": [
        "slide",
        "deck",
        "package"
      ]
    },
    "subjectId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "profile": {
      "enum": [
        "quick-engineering",
        "default-agentic",
        "deterministic-template"
      ]
    },
    "quickGenerate": {
      "type": "boolean"
    },
    "passed": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "sev2",
              "sev1"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contentQa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preRender",
        "finalSvg",
        "compiledPptx"
      ],
      "properties": {
        "preRender": {
          "type": "object",
          "additionalProperties": true
        },
        "finalSvg": {
          "type": "object",
          "additionalProperties": true
        },
        "compiledPptx": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "reportId",
    "subjectType",
    "subjectId",
    "passed",
    "findings",
    "checkedAt"
  ]
}
