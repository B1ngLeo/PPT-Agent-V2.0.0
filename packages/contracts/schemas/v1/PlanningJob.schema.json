{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.instant-ppt.example/v1/PlanningJob.schema.json",
  "title": "PlanningJob",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "planningJobId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "draftId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "operation": {
      "enum": [
        "intent_infer",
        "outline_generate"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "retrying",
        "succeeded",
        "failed"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "terminal": {
      "type": "boolean"
    },
    "retryable": {
      "type": "boolean"
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "resultRevisionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "startedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "finishedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "planningJobId",
    "draftId",
    "operation",
    "status",
    "attempt",
    "maxAttempts",
    "terminal",
    "retryable",
    "errorCode",
    "resultRevisionId",
    "provider",
    "model",
    "createdAt",
    "updatedAt",
    "startedAt",
    "finishedAt"
  ]
}
