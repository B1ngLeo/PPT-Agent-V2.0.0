{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.instant-ppt.example/v1/JobEvent.schema.json",
  "title": "JobEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "job.queued",
        "job.started",
        "job.stage.changed",
        "job.cancel.requested",
        "job.cancelled",
        "job.completed",
        "job.partially_completed",
        "job.failed",
        "slide.started",
        "slide.stage.changed",
        "slide.ready",
        "slide.failed",
        "slide.retrying",
        "qa.completed",
        "artifact.published"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "slideId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "total"
      ],
      "properties": {
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "jobId",
    "seq",
    "type",
    "occurredAt",
    "snapshotId",
    "slideId",
    "attempt",
    "stage",
    "status",
    "progress",
    "data",
    "traceId"
  ]
}
