{
  "$defs": {
    "AgentRuntimePolicy": {
      "additionalProperties": false,
      "properties": {
        "allowedTools": {
          "items": {
            "enum": [
              "read-source",
              "write-project",
              "run-vendored-script",
              "start-live-preview",
              "provider-text",
              "provider-image",
              "approved-web",
              "read_approved_context",
              "read_design_spec_contract",
              "read_spec_lock_contract",
              "read_ppt_master_reference",
              "write_planning_artifact",
              "read_design_catalog",
              "write_or_patch_slide_svg",
              "run_svg_gate",
              "render_slide_or_deck",
              "run_chart_gate",
              "request_visual_review",
              "complete_or_pause_stage"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowedtools",
          "type": "array"
        },
        "allowSubagentResearch": {
          "default": false,
          "title": "Allowsubagentresearch",
          "type": "boolean"
        },
        "allowSubagentReview": {
          "default": false,
          "title": "Allowsubagentreview",
          "type": "boolean"
        },
        "allowSubagentSvgAuthoring": {
          "const": false,
          "default": false,
          "title": "Allowsubagentsvgauthoring",
          "type": "boolean"
        },
        "maxTurns": {
          "maximum": 200,
          "minimum": 1,
          "title": "Maxturns",
          "type": "integer"
        },
        "maxTokens": {
          "anyOf": [
            {
              "maximum": 2000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional cumulative input-plus-output token stop. Null keeps token usage observable without terminating long presentation runs.",
          "title": "Maxtokens"
        },
        "maxCostMicrounits": {
          "minimum": 0,
          "title": "Maxcostmicrounits",
          "type": "integer"
        },
        "maxCompletionTokensPerTurn": {
          "default": 8000,
          "maximum": 100000,
          "minimum": 128,
          "title": "Maxcompletiontokensperturn",
          "type": "integer"
        },
        "maxContextCharacters": {
          "default": 600000,
          "maximum": 4000000,
          "minimum": 10000,
          "title": "Maxcontextcharacters",
          "type": "integer"
        },
        "inputCostMicrounitsPer1K": {
          "default": 0,
          "maximum": 10000000,
          "minimum": 0,
          "title": "Inputcostmicrounitsper1K",
          "type": "integer"
        },
        "outputCostMicrounitsPer1K": {
          "default": 0,
          "maximum": 10000000,
          "minimum": 0,
          "title": "Outputcostmicrounitsper1K",
          "type": "integer"
        },
        "softTimeoutSeconds": {
          "maximum": 43200,
          "minimum": 30,
          "title": "Softtimeoutseconds",
          "type": "integer"
        },
        "hardTimeoutSeconds": {
          "maximum": 86400,
          "minimum": 60,
          "title": "Hardtimeoutseconds",
          "type": "integer"
        },
        "previewIdleTimeoutSeconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Previewidletimeoutseconds",
          "type": "integer"
        },
        "maxStageAttempts": {
          "maximum": 5,
          "minimum": 1,
          "title": "Maxstageattempts",
          "type": "integer"
        }
      },
      "required": [
        "allowedTools",
        "maxTurns",
        "maxTokens",
        "maxCostMicrounits",
        "softTimeoutSeconds",
        "hardTimeoutSeconds",
        "previewIdleTimeoutSeconds",
        "maxStageAttempts"
      ],
      "title": "AgentRuntimePolicy",
      "type": "object"
    },
    "ApprovalSnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "snapshotId": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Snapshotid",
          "type": "string"
        },
        "snapshotSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshotsha256",
          "type": "string"
        },
        "intentRevisionId": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Intentrevisionid",
          "type": "string"
        },
        "outlineRevisionId": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Outlinerevisionid",
          "type": "string"
        },
        "approvalId": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Approvalid",
          "type": "string"
        },
        "approvedBy": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Approvedby",
          "type": "string"
        },
        "approvedAt": {
          "format": "date-time",
          "title": "Approvedat",
          "type": "string"
        }
      },
      "required": [
        "snapshotId",
        "snapshotSha256",
        "intentRevisionId",
        "outlineRevisionId",
        "approvalId",
        "approvedBy",
        "approvedAt"
      ],
      "title": "ApprovalSnapshotRef",
      "type": "object"
    },
    "ApprovedIntent": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "objective": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "audience": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Audience",
          "type": "string"
        },
        "desiredOutcome": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Desiredoutcome",
          "type": "string"
        },
        "language": {
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})+$",
          "title": "Language",
          "type": "string"
        },
        "deliveryContext": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Deliverycontext",
          "type": "string"
        }
      },
      "required": [
        "title",
        "objective",
        "audience",
        "desiredOutcome",
        "language",
        "deliveryContext"
      ],
      "title": "ApprovedIntent",
      "type": "object"
    },
    "ApprovedOutlineSlide": {
      "additionalProperties": false,
      "properties": {
        "outlineSlideId": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Outlineslideid",
          "type": "string"
        },
        "slideId": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Slideid",
          "type": "string"
        },
        "pnn": {
          "pattern": "^P\\d{2,3}$",
          "title": "Pnn",
          "type": "string"
        },
        "order": {
          "maximum": 30,
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "role": {
          "enum": [
            "cover",
            "section",
            "content",
            "data",
            "comparison",
            "timeline",
            "risk_action",
            "ending"
