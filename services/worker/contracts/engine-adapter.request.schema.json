        },
        "visualReviewPolicyVersion": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Visualreviewpolicyversion",
          "type": "string"
        },
        "visualReviewRequired": {
          "title": "Visualreviewrequired",
          "type": "boolean"
        },
        "visualReviewLevel": {
          "anyOf": [
            {
              "enum": [
                "off",
                "standard"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visualreviewlevel"
        },
        "authoringModel": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authoringmodel"
        },
        "visualReviewModel": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visualreviewmodel"
        },
        "visualReviewMaxRounds": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visualreviewmaxrounds"
        }
      },
      "required": [
        "mode",
        "policyVersion",
        "disclosure",
        "visualReviewPolicyVersion",
        "visualReviewRequired"
      ],
      "title": "AuthoringPolicy",
      "type": "object"
    },
    "ConfirmationPolicy": {
