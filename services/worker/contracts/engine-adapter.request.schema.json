            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallbackreason"
        },
        "disclosure": {
          "enum": [
            "agent-authored-editable-draft",
            "template-limited-editable-draft"
          ],
          "title": "Disclosure",
