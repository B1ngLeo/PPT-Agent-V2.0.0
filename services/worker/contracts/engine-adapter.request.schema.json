          "type": "string"
        },
        "license": {
          "default": "user-provided",
          "maxLength": 160,
          "minLength": 1,
          "title": "License",
          "type": "string"
        }
      },
      "required": [
        "assetId",
        "filename",
        "workspaceKey",
        "sha256",
        "mediaType",
        "purpose",
        "slideIds"
      ],
      "title": "ProvidedImageAsset",
      "type": "object"
