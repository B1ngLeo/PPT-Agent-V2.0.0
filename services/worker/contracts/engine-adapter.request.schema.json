          "title": "Role",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "audienceQuestion": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Audiencequestion",
          "type": "string"
        }
      },
      "required": [
        "outlineSlideId",
        "slideId",
        "pnn",
        "order",
        "role",
        "title",
        "audienceQuestion"
      ],
      "title": "ApprovedOutlineSlide",
      "type": "object"
    },
    "ApprovedSourceArtifact": {
      "additionalProperties": false,
      "properties": {
        "sourceArtifactId": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Sourceartifactid",
          "type": "string"
        },
        "sourceId": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Sourceid",
          "type": "string"
        },
        "organizationId": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Organizationid",
          "type": "string"
        },
        "objectSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Objectsha256",
          "type": "string"
        },
        "mediaType": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Mediatype",
          "type": "string"
        },
        "privateNonce": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 12,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Privatenonce"
        },
        "parsedAt": {
          "format": "date-time",
          "title": "Parsedat",
          "type": "string"
        },
        "fragments": {
          "items": {
            "$ref": "#/$defs/SourceFragment"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Fragments",
          "type": "array"
        }
      },
      "required": [
        "sourceArtifactId",
        "sourceId",
        "organizationId",
        "objectSha256",
        "mediaType",
        "parsedAt",
        "fragments"
      ],
      "title": "ApprovedSourceArtifact",
      "type": "object"
    },
    "AuthoringPolicy": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "agent-authoring",
