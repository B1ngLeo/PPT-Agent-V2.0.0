# Local-only, non-production defaults. Copy to .env and replace locally when needed.
POSTGRES_DB=instant_ppt
POSTGRES_USER=instant_ppt
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://instant_ppt:local-development-only@127.0.0.1:5432/instant_ppt
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
REDIS_URL=redis://localhost:6379/0
REDIS_EVENTS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
SSE_HEARTBEAT_SECONDS=20
OUTBOX_POLL_SECONDS=0.25
WORKER_LEASE_SECONDS=30
CELERY_VISIBILITY_TIMEOUT_SECONDS=9000
GENERATION_TASK_SOFT_TIME_LIMIT_SECONDS=7800
GENERATION_TASK_TIME_LIMIT_SECONDS=8100
APP_ENVIRONMENT=local
APP_BUILD_REVISION=dev-uncommitted
RUNTIME_CONTRACT_VERSION=instant-ppt-runtime@v2
OTEL_TRACES_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT is intentionally omitted locally. Production must use an internal TLS collector URL.
AUTH_MODE=local
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=https://api.instant-ppt.example
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_ALGORITHMS=RS256
OIDC_CLOCK_SKEW_SECONDS=30
DOWNLOAD_URL_TTL_SECONDS=900
UPLOAD_SESSION_TTL_SECONDS=600
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEV_USER_SUBJECT=local-web-user
# Fake remains the safe regression default. Set kimi or qwen for live planning.
PLANNING_BACKEND=qwen
PLANNING_TRANSPORT_MAX_RETRIES=1
# The website uses Qwen for intent, outline planning, and presentation authoring.
TEXT_PROVIDER=qwen
PROVIDER_GATEWAY_URL=http://localhost:8090/internal/v1
PROVIDER_GATEWAY_TOKEN=replace-with-a-separate-internal-service-token
PROVIDER_GATEWAY_TIMEOUT_SECONDS=150
PROVIDER_CONFIG_VERSION=deterministic-fake-v1
# NEXT_PUBLIC_A11Y_AUDIT is a build-time QA switch only; never enable it in a release build.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=instant-ppt-local
S3_SECRET_KEY=local-development-only
S3_BUCKET=instant-ppt-private
# Development-only static KMS key for local MinIO SSE-S3 verification. Production must use KES/KMS, never this key.
MINIO_KMS_SECRET_KEY=instant-ppt-local:aW5zdGFudC1wcHQtbG9jYWwtc3NlLWtleS0zMmJ5dGU=
MINIO_API_STALE_UPLOADS_EXPIRY=24h
MINIO_API_STALE_UPLOADS_CLEANUP_INTERVAL=1h
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3000
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
KIMI_PROTOCOL=openai
KIMI_REASONING_EFFORT=max
KIMI_TIMEOUT_SECONDS=600
KIMI_TRANSPORT_MAX_RETRIES=4
KIMI_RETRY_BACKOFF_SECONDS=2
KIMI_ANTHROPIC_STREAMING=false
KIMI_INPUT_COST_MICROUNITS_PER_1K=0
KIMI_OUTPUT_COST_MICROUNITS_PER_1K=0
# Only official DashScope/Model Studio compatible endpoints are accepted.
QWEN_OFFICIAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_REASONING_EFFORT=medium
QWEN_ENABLE_THINKING=true
QWEN_PRESERVE_THINKING=false
QWEN_TIMEOUT_SECONDS=600
QWEN_TRANSPORT_MAX_RETRIES=4
QWEN_RETRY_BACKOFF_SECONDS=2
QWEN_STREAMING=true
PRESENTATION_MAX_COMPLETION_TOKENS_PER_TURN=40000
QWEN_INTENT_MAX_COMPLETION_TOKENS=18000
QWEN_OUTLINE_MAX_COMPLETION_TOKENS=20000
QWEN_VISUAL_STYLE_MAX_COMPLETION_TOKENS=8000
QWEN_INPUT_COST_MICROUNITS_PER_1K=0
QWEN_OUTPUT_COST_MICROUNITS_PER_1K=0
PRESENTATION_AUTHORING_MODE=agent-authoring
PRESENTATION_NATIVE_CHARTS_ENABLED=false
# The configured gateway must support streaming image-content requests.
PRESENTATION_VISUAL_REVIEW_REQUIRED=true
# MOONSHOT_API_KEY is intentionally omitted. Supply it through a local secret store.
# QWEN_OFFICIAL_API_KEY is intentionally omitted. Supply it through a local secret store.
IMAGE_BACKEND=openai
IMAGE_GENERATION_ENABLED=false
IMAGE_MAX_PER_DECK=0
IMAGE_COST_MICROUNITS=100000
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-image-2
OPENAI_OUTPUT_FORMAT=png
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_TIMEOUT_SECONDS=300
# OPENAI_API_KEY is intentionally omitted. Supply it through a local secret store.
